{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "snapshot.schema.json",
  "title": "Private data/snapshots/<date>.json.gz",
  "type": "object",
  "required": [
    "date",
    "status",
    "rules_version",
    "bundle_hash",
    "models_listed",
    "dealers_json",
    "slider_counts",
    "offers"
  ],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "enum": [
        "ok",
        "suspect"
      ]
    },
    "slider_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "integer"
        }
      }
    },
    "offers": {
      "type": "array",
      "items": {
        "$ref": "offer.schema.json"
      }
    }
  }
}
